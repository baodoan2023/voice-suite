{"utt_id": "fleurs-001946", "asr_text": "CÁC CHÍNH SÁCH HỦY CÓ KHÁC NHAU TUY NHIÊN TÍNH ĐẾN CUỐI THÁNG BA HẦU HẾT CÁC CHÍNH SÁCH HỦY DO VIRUS CORONA ĐỀU KHÔNG CHO PHÉP GIA HẠN ĐẾN THÁNG BẢY NĂM HAI NGÀN KHÔNG TRĂM HAI MƯƠI THỜI ĐIỂM DIỄN RA THẾ VẬN HỘI THEO KẾ HOẠCH", "asr_ms": 647}
{"utt_id": "fleurs-001947", "asr_text": "TRƯỚC KHI QUÂN ĐỘI CÓ MẶT HA KHÔNG GẶP PHẢI CÁC VẤN ĐỀ LIÊN QUAN ĐẾN BỆNH NÀY TỪ NHỮNG NĂM MỘT NGÀN TÁM TRĂM", "asr_ms": 445}
{"utt_id": "fleurs-001948", "asr_text": "TAM QUỐC LÀ MỘT TRONG NHỮNG KỶ NGUYÊN ĐẪM MÁU NHẤT TRONG LỊCH SỬ HOA CỔ ĐẠI HÀNG NGÀN NGƯỜI ĐÃ CHẾT CHỈ ĐỂ TRANH RỒI VÀO NGA HOÀNG TRONG ĐẠI DIỆN Ở THÀNH TÂY AN", "asr_ms": 729}
{"utt_id": "fleurs-001950", "asr_text": "NẰM VỀ PHÍA BẮC VÀ THUẬN TIỆN VỀ GIAO THÔNG LÀ THỊ TRẤNA LÃNG MẠN VÀ HẤP DẪN NỔI TIẾNG VỚI NGƯỜI NƯỚC NGOÀI SAU MỘT BÀI THƠ CA NGỢI CỦA LO BIN", "asr_ms": 738}
{"utt_id": "fleurs-001951", "asr_text": "NĂM HAI NGÀN LẺ HAI THÀNH PHỐ GOMA BỊ SAN BẰNG BỞI NÚI LỬA NI GONO THẢM HỌA LỬA NÀY ĐÃ CHÔN VÙI PHẦN LỚN THÀNH PHỐ NÀY ĐẶC BIỆT LÀ KHU VỰC TRUNG TÂM THÀNH PHỐ", "asr_ms": 688}
{"utt_id": "fleurs-001952", "asr_text": "BẤT KỲ AI MUỐN LÁI XE TRÊN KHU VỰC SAU HOẶC BĂNG ĐÈO ĐỀU CẦN KHẢ NĂNG CÓ TUYẾT RƠI BĂNG HOẶC NHIỆT ĐỘ ĐÓNG BĂNG", "asr_ms": 479}
{"utt_id": "fleurs-001953", "asr_text": "ÔNG TA SAU ĐÓ ĐƯỢC CHUYỂN ĐẾN BỆNH VIỆN A ĐEN GỐC Ở CAM RÍ", "asr_ms": 287}
{"utt_id": "fleurs-001955", "asr_text": "BỆNH ĐA XƠ CỨNG ẢNH HƯỞNG ĐẾN HỆ THẦN KINH TRUNG ƯƠNG ĐƯỢC TẠO THÀNH TỪ BỘ NÃO TỦY SỐNG VÀ DÂY THẦN KINH THỊ GIÁC", "asr_ms": 395}
{"utt_id": "fleurs-001957", "asr_text": "EM GỌI NHỮNG TIN ĐỒN NÀY LÀ CUỘC TÁN VỀ CHÍNH TRỊ VÀ SỰ ĐIÊN RỒ", "asr_ms": 287}
{"utt_id": "fleurs-001960", "asr_text": "THEO BÁO CÁO THÌ CẬU ẤY ĐANG Ở ĐỘ TUỔI ĐÔI MƯƠI TRONG MỘT TUYÊN BỐ PI BƠ NÓI RẰNG DÙ TÔI KHÔNG CÓ MẶT VÀ CŨNG KHÔNG LIÊN QUAN TRỰC TIẾP ĐẾN VỤ TAI NẠN THƯƠNG TÂM NÀY TÔI MUỐN GỬI LỜI CHIA BUỒN VÀ NGUYỆN CẦU ĐẾN GIA ĐÌNH NẠN NHÂN", "asr_ms": 648}
{"utt_id": "fleurs-001961", "asr_text": "MỘT TRONG NHỮNG PHƯƠNG PHÁP PHỔ BIẾN NHẤT ĐƯỢC SỬ DỤNG ĐỂ MINH HỌA TẦM QUAN TRỌNG CỦA XÃ HỘI HÓA LÀ DẪN CHỨNG MỘT VÀI TRƯỜNG HỢP ĐÁNG TIẾC VỀ TRẺ EM LIÊN QUAN ĐẾN SỰ BỎ BÊ BẤT HẠNH HOẶC CỐ Ý LẠM DỤNG THIẾU TIẾP XÚC XÃ HỘI ĐẾN TỪ NGƯỜI NUÔI DƯỠNG KHI TRẺ TRƯỞNG THÀNH", "asr_ms": 654}
{"utt_id": "fleurs-001962", "asr_text": "ĐỘ B ĐƯỢC CHỈ THỊ BẰNG SỐ LƯỢNG IOUM HYDRO H TRONG HÓA CHẤT THÍ NGHIỆM", "asr_ms": 502}
{"utt_id": "fleurs-001963", "asr_text": "VIỆC LÀ QUẦN ÁO ƯỚT CÓ THỂ GIÚP CHÚNG KHÔ NHIỀU KHÁCH SẠN CÓ MỘT BÀN LÒ VÀ CẦU BÀN LÀ ĐỂ CHO MƯỢN THẬM CHÍ NGAY CẢ KHI BẠN KHÔNG THẤY CÓ CÁI NÀO TRONG PHÒNG", "asr_ms": 665}
{"utt_id": "fleurs-001966", "asr_text": "LỆNH NÀY LÀ PHẢN ỨNG CỦA MA TÊ LI VỚI CÁC CUỘC BIỂU TÌNH CHỐNG CHẾ ĐỘ LAN RỘNG TỪ THÁNG MƯỜI", "asr_ms": 406}
{"utt_id": "fleurs-001969", "asr_text": "THEO QUY TẮC NÀY VỊ TRÍ HỮU HIỆU NHẤT DÀNH CHO CHỦ THỂ CHÍNH LÀ GIAO ĐIỂM CỦA CÁC ĐƯỜNG PHÂN CHIA HÌNH ẢNH THÀNH BA PHẦN THEO CHIỀU DỌC VÀ CHIỀU NGANG XEM VÍ DỤ", "asr_ms": 647}
{"utt_id": "fleurs-001970", "asr_text": "CHÚNG TA KHÔNG BIẾT CHẮC CHẮN NHƯNG CHÚNG TA CÓ THỂ CÓ LỰA THỨC ĂN CỦA NÓ BAO GỒM RÙA CÁ LỚN NHỮNG CON MOSO KHÁC VÀ NÓ THẬM CHÍ CÓ THỂ LÀ THÚ ĂN THỊT", "asr_ms": 728}
{"utt_id": "fleurs-001974", "asr_text": "TƯƠNG TỰ NAM GIỚI PHẢI MẶC QUẦN DÀI CHE PHỦ ĐẦU GÓI", "asr_ms": 303}
{"utt_id": "fleurs-001975", "asr_text": "DÂN SỐ CỦA THÀNH PHỐ PHANTICAN KHOẢNG TÁM TRĂM NGƯỜI ĐÂY LÀ QUỐC GIA ĐỘC LẬP NHỎ NHẤT TRÊN THẾ GIỚI VÀ LÀ QUỐC GIA CÓ DÂN SỐ ÍT NHẤT", "asr_ms": 388}
{"utt_id": "fleurs-001976", "asr_text": "CÁC CẦU THỦ ĐẬP BÓNG VỊ TRÍ GIỮA SACHIN TENDUNK VÀ RAO ĐA VÍT ĐÃ CHƠI TỐT VÀ LÀ CẶP ĐỐI TÁC Ở ĐƯỜNG CHẠY MỘT TRĂM", "asr_ms": 549}
{"utt_id": "fleurs-001977", "asr_text": "BÀY GỒM CÓ MỘT ĐẾN BA CON ĐƯỢC TRƯỞNG THÀNH CÓ HO HẸN VỚI NHAU CÙNG VỚI KHOẢNG BA MƯƠI CON CÁI VÀ CÁC CON", "asr_ms": 438}
{"utt_id": "fleurs-001978", "asr_text": "ĐỐI VỚI SPRINGBOOK TRẬN NÀY ĐÃ GIÚP ĐỘI TUYỂN KẾT THÚC CHUỖI THUA NĂM TRẬN LIỀN", "asr_ms": 314}
{"utt_id": "fleurs-001980", "asr_text": "KHỐN NỔI RẤT KHÓ ĐỂ NGHIÊN CỨU LƯU LƯỢNG GIAO THÔNG VÌ KHÔNG THỂ ĐOÁN CHẮC CHẮN MỘT TRĂM PHẦN TRĂM HÀNH VI CỦA NGƯỜI LÁI XE", "asr_ms": 515}
{"utt_id": "fleurs-001983", "asr_text": "TỪ VĂN MINH XUẤT PHÁT TỪ CLIAT TRONG TIẾNG LA TINH NGHĨA LÀ THUỘC NHÂN LIÊN QUAN ĐẾN SIT TRONG TIẾNG LA TINH NGHĨA LÀ CÔNG DÂN VÀ CVITAG NGHĨA LÀ THÀNH PHỐ HAY THÀNH BAN VÀ NÓ CŨNG PHẦN NÀO XÁC ĐỊNH QUY MÔ CỦA XÃ HỘI", "asr_ms": 939}
{"utt_id": "fleurs-001984", "asr_text": "VIỆC QUÁ NHIỀU NGƯỜI SỞ HỮU XE HƠI CŨNG DẪN ĐẾN SỰ GIA TĂNG SỐ VỤ TAI NẠN GIAO THÔNG DẪN ĐẾN PHÁT MINH KỸ THUẬT MỚI TRONG NGÀNH Y TẾ ĐỂ PHỤC HỒI NHỮNG TỔN THƯƠNG TRÊN THÂN THỂ", "asr_ms": 652}
{"utt_id": "fleurs-001986", "asr_text": "SỰ HIỆN DIỆN CỦA ĐỘI VÔ HÌNH THỰC SỰ LA SON VÀ LAFTO MỘT NGÀN CHÍN TRĂM TÁM MƯƠI CHÍN TRANG MỘT TRĂM LẺ CHÍN CŨNG LÀ THÀNH PHẦN ĐẶC BIỆT CỦA ĐỘI ẢO", "asr_ms": 837}
{"utt_id": "fleurs-001988", "asr_text": "TRONG THẬP NIÊN MỘT NGÀN CHÍN TRĂM HAI MƯƠI QUAN ĐIỂM PHỔ BIẾN CỦA HẦU HẾT MỌI CÔNG DÂN VÀ QUỐC GIA LÀ THEO KHUYNH HƯỚNG CHỦ NGHĨA HÒA BÌNH VÀ CÔ LẬP", "asr_ms": 657}
{"utt_id": "fleurs-001989", "asr_text": "ÔNG TA CŨNG THAM GIA VÀO VIỆC PHÁT CÁC LOẠI TIỀN GIẤY CHO NHIỀU QUỐC GIA NHỮNG VÍ DỤ GẦN ĐÂY VỀ CÔNG VIỆC CỦA ÔNG ẤY BAO GỒM CHÂN DUNG THỦ TƯỚNG TRÊN MẶT TRƯỚC CỦA TỜ NĂM ĐÔ LA VÀ MỘT TRĂM ĐÔ LA MỚI", "asr_ms": 865}
{"utt_id": "fleurs-001990", "asr_text": "LỐC CŨNG CÓ THỂ GIÚP CẢI THIỆN KHẢ NĂNG VIẾT LÁCH CỦA HỌC SINH KHI BẮT ĐẦU VIẾT NHỮNG HỌC SINH NÀY THƯỜNG MẮC LỖI PHÁP VÀ CHÍNH TẢ DO CẨU THẢ SỰ HIỆN DIỆN CỦA ĐỘC GIẢ NHÌN CHUNG LÀM THAY ĐỔI ĐIỀU ĐÓ", "asr_ms": 744}
{"utt_id": "fleurs-001991", "asr_text": "TRONG SUỐT THỜI KỲ NÀY CỦA LỊCH SỬ CHÂU ÂU NHÀ THỜ CÔNG GIÁO LÚC NÀY ĐÃ TRỞ NÊN GIÀU CÓ VÀ QUYỀN LỰC BẮT ĐẦU CHỊU SỰ SOI SÉT", "asr_ms": 589}
{"utt_id": "fleurs-001992", "asr_text": "THUẬT NGỮ SA RI ĐƯỢC SỬ DỤNG PHỔ BIẾN ĐỂ CHỈ VIỆC DU LỊCH ĐƯỜNG BỘ ĐỂ CHIÊM NGƯỠNG CUỘC SỐNG HOANG DÃ TẠI CHÂU PHI ĐẶC BIỆT LÀ SAPA", "asr_ms": 573}
{"utt_id": "fleurs-001995", "asr_text": "PHƯƠNG PHÁP SCAPON ẢO ĐƯỢC NỘI TẠI HÓA TRONG PHẦN MỀM VÀ CÓ MỤC ĐÍCH NHẰM ĐẶT CÂU HỎI NHẮC NHỞ VÀ GIẢI THÍCH CÁC QUY TRÌNH MÀ CÓ THỂ THÁCH THỨC CÁC HỌC SINH GIẢI QUYẾT VẤN ĐỀ MỘT MÌNH", "asr_ms": 635}
{"utt_id": "fleurs-001996", "asr_text": "BITEL GOOLAY CỦA AUSTRALIA VỀ ĐÍCH Ở VỊ TRÍ THỨ MƯỜI MỘT Ở CUỘC ĐUA SUPER ĐỨNG DÀNH CHO NAM ĐỐI THỦ ĐẾN TỪ SÉCRI VỀ ĐÍCH Ở VỊ TRÍ THỨ MƯỜI SÁU Ở CUỘC ĐUA SUPERI NGỒI DÀNH CHO NAM", "asr_ms": 908}
{"utt_id": "fleurs-001997_male_southern", "asr_text": "TUY NHIÊN DƯỜNG NHƯG T TRONG TỔNG SỐ NGƯỜI MẮC BỆNH LAO VẪN CÒN Ở MỨC THẤP CHỈ CÓ SÁU NGÀN TRONG TỔNG SỐ BA TRĂM BA MƯƠI NGÀN NGƯỜI BỊ NHIỄM BỆNH TẠI MỘT THỜI ĐIỂM CỤ THỂ BẤT KỲ TẠI NAM PHI", "asr_ms": 730}
{"utt_id": "fleurs-001999", "asr_text": "TRONG SỐ THẬP NIÊN MỘT NGÀN CHÍN TRĂM SÁU MƯƠI REZINKI LÀM VIỆC CHON ÉP KEN NE TRONG VAI TRÒ VÀ SAU ĐÓ LÀM VIỆC CHO CHÍNH QUYỀN LIN SON", "asr_ms": 700}
{"utt_id": "fleurs-002000", "asr_text": "NẾU VƯỢT BIỂN BẮC VÀO MÙA ĐÔNG HÃY KIỂM TRA LẠI BUỒN NGỦ VÌ KHI TÀU PHÁ BĂNG SẼ TẠO RA NHỮNG TIẾNG ỒN KINH KHỦNG MÀ KHÔNG PHẢI AI CŨNG CHỊU ĐỰNG ĐƯỢC", "asr_ms": 469}
{"utt_id": "fleurs-002001", "asr_text": "DU KHÁCH ĐƯỢC KHUYẾN CÁO NÊN ĐỀ PHÒNG MỌI RỦI RO THỜI TIẾT KHẮC NGHIỆT ẢNH HƯỞNG ĐẾN KHU VỰC CỦA HỌ VÌ THỜI TIẾT KHẮC NGHIỆT CÓ THỂ ẢNH HƯỞNG ĐẾN BẤT KỲ KẾ HOẠCH DU LỊCH NÀO", "asr_ms": 478}
{"utt_id": "fleurs-002004", "asr_text": "CÙNG THÁNG ĐÓ CŨNG CHỨNG KIẾN MỘT MÁY BAY KHÁC CHẠY QUÁ ĐƯỜNG BĂNG TẠI MASTA VÀ ĐÂM VÀO MỘT BỨC TƯỜNG LÀM THIỆT MẠNG MƯỜI BẢY NGƯỜI", "asr_ms": 611}
{"utt_id": "fleurs-002009", "asr_text": "CÁC NGUỒN THỰC VẬT CÓ THỂ TIẾP CẬN NHANH NHẤT HẲN SẼ LÀ NGUỒN PROTEIN CÓ TRONG LÁ VÀ CÂY HỌ ĐẬU NHƯNG CHÚNG KHÓ CHO NHỮNG LOÀI LINH TRƯỞNG NHƯ CHÚNG TA TIÊU HÓA TRỪ KHI ĐƯỢC NẤU CHÍN", "asr_ms": 689}
